# Copy to backend/.env and fill in. backend/.env is git-ignored: never commit keys.

# Path to the catalogue workbook (default: data/catalogue/Stompbox_100_Product_Catalogue_No_Sale_Pricing.xlsx)
# CATALOGUE_PATH=

# --- Search providers (Phase 2) ---
# Active provider (decided 2026-11-10 after benchmark): exa. tavily is optional; brave is disabled.
SEARCH_PROVIDER=exa
# EXA_API_KEY is required for the active provider. TAVILY/BRAVE keys are only needed to run them explicitly or to benchmark.
EXA_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Optional tuning (defaults shown)
# SEARCH_TIMEOUT_SECONDS=20
# CONTENT_TIMEOUT_SECONDS=45
# SEARCH_MAX_RETRIES=2
# EXA_SEARCH_TYPE=auto
# EXA_CONTENT_MAX_AGE_HOURS=24
# EXA_LIVECRAWL_TIMEOUT_MS=15000
# TAVILY_SEARCH_DEPTH=basic
# TAVILY_EXTRACT_DEPTH=basic
# TAVILY_USD_PER_CREDIT=0.008
# BRAVE_USD_PER_1K_REQUESTS=5

# --- LLM gateway: OpenRouter (Phase 3+) ---
OPENROUTER_API_KEY=
# Model ids are OpenRouter ids (provider/model). There is no default model: a user decision.
# Chosen 2026-11-14 for both LLMs: openai/gpt-6-luna (a reasoning model; supports structured
# outputs and reasoning effort, but NOT temperature).
# LLM 1 (competitor discovery). No default. Must support structured outputs on OpenRouter.
LLM1_MODEL=
# Temperature is sent only when set (an explicit 0 is sent). Leave it unset for models that
# reject it, e.g. reasoning models: OpenRouter would otherwise find no endpoint for the request.
# LLM1_TEMPERATURE=
# Reasoning effort: none | minimal | low | medium | high | xhigh. Unset = not sent (model default).
# LLM1_REASONING_EFFORT=low
# Includes reasoning tokens. Raise it for reasoning models (12000 used with gpt-6-luna).
# LLM1_MAX_COMPLETION_TOKENS=6000
# LLM_TIMEOUT_SECONDS=90
# LLM_MAX_RETRIES=2

# --- Competitor discovery (Phase 3). Thresholds are starting values, not calibrated. ---
# Without OPENROUTER_API_KEY + LLM1_MODEL, discovery runs in LLM_DISABLED mode
# (baseline queries, no classification, every new company needs approval).
# DISCOVERY_USE_LLM=true
# DISCOVERY_AUTO_APPROVE_MIN_CONFIDENCE=0.85
# DISCOVERY_AUTO_APPROVE_MIN_RELEVANCE=0.75
# DISCOVERY_AUTO_APPROVE_MIN_EVIDENCE_URLS=2
# DISCOVERY_REJECT_MAX_RELEVANCE=0.3
# DISCOVERY_MAX_GLOBAL_QUERIES_PER_PRODUCT=4
# DISCOVERY_RESULTS_PER_QUERY=10
# DISCOVERY_MAX_CANDIDATES=15
# DISCOVERY_PROFILE_RESULTS=3
# DISCOVERY_MAX_TARGETED_VARIANTS=2
# OWN_DOMAINS=["stompbox.co.uk"]
# Competitors removed by the user: excluded from discovery and never added to the review queue.
# DISCOVERY_EXCLUDED_COMPETITOR_DOMAINS=["pmtonline.co.uk"]

# --- Competitor review (Phase 4) ---
# Persistent reviewer decisions (SQLite, git-ignored). Default: data/review/competitor_review.sqlite3
# REVIEW_DB_PATH=
# Registrable names treated as marketplaces (never auto-approved; reviewers must type them 'marketplace')
# MARKETPLACE_DOMAIN_LABELS=["amazon","ebay","reverb","etsy","gumtree"]

# --- Product intelligence, LLM 2 (Phase 5) ---
# LLM 2 (extraction). No default; must support structured outputs on OpenRouter.
# Without OPENROUTER_API_KEY + LLM2_MODEL, runs in LLM_DISABLED mode (search + retrieval only).
LLM2_MODEL=
# LLM2_TEMPERATURE=
# LLM2_REASONING_EFFORT=low
# Includes reasoning tokens (8000 used with gpt-6-luna).
# LLM2_MAX_COMPLETION_TOKENS=3000
# INTELLIGENCE_USE_LLM=true
# INTELLIGENCE_QUERIES_PER_DOMAIN=1
# INTELLIGENCE_RESULTS_PER_QUERY=5
# INTELLIGENCE_MAX_PAGES_PER_DOMAIN=2
# INTELLIGENCE_MAX_PAGES_PER_PRODUCT=20
# INTELLIGENCE_PAGE_CHARS=12000
# INTELLIGENCE_EXCLUDED_COMPANY_TYPES=["directory"]
# Second LLM 2 call (match proposal) per retrieved single-product page:
# INTELLIGENCE_MATCH_PROPOSALS=true

# --- Matching (Phase 6) ---
# MATCHING_PRICE_MAX_AGE_HOURS=24

# --- Pipeline runs (Phase 7). Run state is in memory only. ---
# PIPELINE_MAX_PRODUCTS_PER_RUN=5
# PIPELINE_MAX_ACTIVE_RUNS=2
# PIPELINE_RUN_TIMEOUT_SECONDS=1800
# PIPELINE_DISCOVERY_TIMEOUT_SECONDS=300
# PIPELINE_PRODUCT_TIMEOUT_SECONDS=600
# PIPELINE_RUN_TTL_MINUTES=120
# PIPELINE_MAX_RUNS_RETAINED=50
# PIPELINE_SEARCH_AUTO_APPROVED=true
# PIPELINE_SSE_HEARTBEAT_SECONDS=15
